          },
          "approach": {
            "type": "string",
            "maxLength": 200,
            "title": "Approach"
          },
          "timeComplexity": {
            "type": "string",
            "maxLength": 80,
            "title": "Timecomplexity"
          },
          "spaceComplexity": {
            "type": "string",
            "maxLength": 80,
            "title": "Spacecomplexity"
          },
          "code": {
            "type": "string",
            "maxLength": 200000,
            "title": "Code"
          },
          "thoughts": {
            "type": "string",
            "maxLength": 200000,
            "title": "Thoughts"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "problemId": {
            "type": "integer",
            "title": "Problemid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
