              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "needsReview": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Needsreview"
          },
          "problemId": {
            "type": "integer",
            "title": "Problemid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "problemId"
        ],
        "title": "ImportedProgress"
      },
